# ==============================================================================
# YUKIRA V1 — Environment Configuration & Secrets Template
# Instructions: Copy to .env and configure for your target deployment environment.
# Never commit actual credentials, signing keys, CAS passwords, or secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=yukira
POSTGRES_USER=yukira
POSTGRES_PASSWORD=change_this_to_a_secure_password
POSTGRES_PORT=5432

# Spring Boot Datasource (derived automatically in docker-compose)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/yukira
SPRING_DATASOURCE_USERNAME=yukira
SPRING_DATASOURCE_PASSWORD=change_this_to_a_secure_password

# ------------------------------------------------------------------------------
# 2. Quantitative Engine Microservice (Python FastAPI)
# ------------------------------------------------------------------------------
QUANT_ENGINE_PORT=8001
QUANT_ENGINE_URL=http://localhost:8001

# ------------------------------------------------------------------------------
# 3. Spring Boot Backend Orchestrator & Security
# ------------------------------------------------------------------------------
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# OAuth2 Resource Server JWT Verification
JWT_ISSUER_URI=https://dev-zpiz2xr3hd7ukpi3.us.auth0.com/
JWT_AUDIENCES=https://api.yukira.app

# File Storage & Persistent Artifact Paths
YUKIRA_STORAGE_PATH=/var/data/yukira
CAS_MAX_FILE_SIZE=15MB
CAS_MAX_REQUEST_SIZE=20MB

# ------------------------------------------------------------------------------
# 4. Presentation Tier (Next.js 16)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Auth0 Next.js Client Configuration
AUTH0_SECRET=generate_a_random_32_character_secret_here
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=https://dev-zpiz2xr3hd7ukpi3.us.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id_placeholder
AUTH0_CLIENT_SECRET=your_auth0_client_secret_placeholder
AUTH0_AUDIENCE=https://api.yukira.app

# ------------------------------------------------------------------------------
# 5. Scheduled Daily Market Data Ingestion Pipelines
# ------------------------------------------------------------------------------
# Enable scheduled automated daily pipelines (set to true for live operational nodes)
YUKIRA_AMFI_NAV_REFRESH_ENABLED=false
YUKIRA_AMFI_NAV_REFRESH_CRON=0 0 23 * * ?
YUKIRA_AMFI_NAV_REFRESH_MAX_RETRIES=3
YUKIRA_AMFI_NAV_REFRESH_RETRY_DELAY_MS=2000

YUKIRA_BENCHMARK_REFRESH_ENABLED=false
YUKIRA_BENCHMARK_REFRESH_CRON=0 30 23 * * ?

YUKIRA_FBIL_REFRESH_ENABLED=false
YUKIRA_FBIL_REFRESH_CRON=0 45 23 * * ?

YUKIRA_HOLDINGS_REFRESH_ENABLED=false
YUKIRA_HOLDINGS_REFRESH_CRON=0 0 2 12 * ?
YUKIRA_HOLDINGS_DISCOVERY_ENABLED=true

